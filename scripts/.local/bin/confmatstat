#!/usr/bin/env python
#
import sys

if(len(sys.argv) != 5):
    print ("Usage: true positive, true negative, false positive, false negative")
    print("Output in typst table format: Placeholder Accuracy Precision Specificity Recall F-1 Score")
    quit()

for i in range(len(sys.argv)):
    if(i == 0):
        continue;
    if(not sys.argv[i].isnumeric()):
        print ("Usage: true positive, true negative, false positive, false negative")
        print ("Must be natural numbers")
        quit()


true_positive = int(sys.argv[1])
true_negative = int(sys.argv[2])
false_positive = int(sys.argv[3])
false_negative = int(sys.argv[4])

accuracy = (true_positive + true_negative) / (true_positive + true_negative + false_positive + false_negative)
precision = true_positive / (true_positive + false_positive)
specificity = true_negative / (true_negative + false_positive)

if(true_positive == 0):
    recall = 0;
    f1 = 0;
else:
    recall = true_positive / (true_positive + false_negative)
    f1 = (2 * precision * recall) / (precision + recall)


print(f"[Placeholder], [{accuracy}], [{precision}], [{specificity}], [{recall}], [{f1}],")

# print("Metric\tResult")
# print(f"Accuracy\t {accuracy}")
# print(f"Precision\t {precision}")
# print(f"Specificity\t {specificity}")
# print(f"Recall\t {recall}")
# print(f"F-1 Score\t {f1}")
